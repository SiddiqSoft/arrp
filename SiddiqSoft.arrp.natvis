<?xml version="1.0" encoding="utf-8"?>
<AutoVisualizer xmlns="http://schemas.microsoft.com/vstudio/debugger/natvis/2010">
  <Type Name="siddiqsoft::arrp::resource_guard&lt;*&gt;">
    <DisplayString>{m_is_valid ? "resource_guard [valid]" : "resource_guard [invalid]"}</DisplayString>
    <Expand>
      <Item Name="[Resource]">m_rsrc</Item>
      <Item Name="[Valid]">m_is_valid</Item>
      <Item Name="[Error]">m_error_code</Item>
      <Item Name="[Has callback]">m_putback_callback != nullptr</Item>
    </Expand>
  </Type>

  <Type Name="siddiqsoft::arrp::resource_pool&lt;*&gt;">
    <DisplayString>{m_capacity, en} capacity, {m_pool.size(), en} available, {m_resources_checkedout, en} checked out</DisplayString>
    <Expand>
      <Item Name="[Capacity]">m_capacity</Item>
      <Item Name="[Available]">m_pool</Item>
      <Item Name="[Checked out]">m_resources_checkedout</Item>
      <Item Name="[Shutdown]">m_is_shutdown</Item>
      <Item Name="[Abandons]">m_counter_abandons</Item>
      <Item Name="[Peak pool size]">m_peak_poolsize</Item>
      <Item Name="[Counters]">
        <Expand>
          <Item Name="Borrows">m_counter_borrows</Item>
          <Item Name="Returns">m_counter_returns</Item>
          <Item Name="Seeds">m_counter_seeds</Item>
          <Item Name="On-demand adds">m_counter_ondemand_adds</Item>
          <Item Name="Loans">loan_size()</Item>
        </Expand>
      </Item>
      <Item Name="[Callbacks]">
        <Expand>
          <Item Name="Factory callback registered">m_factory_callback != nullptr</Item>
          <Item Name="Cleanup callback registered">m_callback_on_resource_cleanup != nullptr</Item>
        </Expand>
      </Item>
    </Expand>
  </Type>
</AutoVisualizer>
