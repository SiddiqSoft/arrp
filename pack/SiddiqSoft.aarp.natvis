<?xml version="1.0" encoding="utf-8"?>
<!--
    SiddiqSoft.aarp.natvis
    
    Natvis file for debugging siddiqsoft::arrp library types in Visual Studio and VS Code.
    
    This file provides custom visualizations for:
    - siddiqsoft::arrp::resource_pool: Thread-safe auto-returning resource pool
    - siddiqsoft::arrp::resource_guard: RAII wrapper for resource lifecycle management
    
    Installation:
    - Visual Studio: Copy to %USERPROFILE%\Documents\Visual Studio 20XX\Visualizers\
    - VS Code: Use with C++ extension and native debugging
    
    BSD 3-Clause License
    Copyright (c) 2026 Abdulkareem Siddiq
-->

<AutoVisualizer xmlns="http://schemas.microsoft.com/vstudio/debugger/natvis/2010">

  <!-- ============================================================================
       resource_guard<T> - RAII wrapper for resource lifecycle management
       ============================================================================ -->
  <Type Name="siddiqsoft::arrp::resource_guard&lt;*&gt;">
    <DisplayString Condition="m_is_valid">resource_guard&lt;{$T1}&gt; [valid, err:{m_error_code}]</DisplayString>
    <DisplayString Condition="!m_is_valid">resource_guard&lt;{$T1}&gt; [invalid, err:{m_error_code}]</DisplayString>
    <Expand>
      <Item Name="[Resource]">m_rsrc</Item>
      <Item Name="[Valid]">m_is_valid</Item>
      <Item Name="[Has Callback]">m_putback_callback != nullptr</Item>
      <Item Name="[Error]">m_error_code</Item>
    </Expand>
  </Type>

  <!-- ============================================================================
       resource_pool<T, SRT> - Thread-safe resource pool
       ============================================================================ -->
  <Type Name="siddiqsoft::arrp::resource_pool&lt;*,*&gt;">
    <DisplayString>resource_pool&lt;{$T1}&gt; [size:{m_pool.size()}, checked_out:{m_resources_checkedout}, capacity:{m_capacity}]</DisplayString>
    <Expand>
      <Item Name="[Capacity]">m_capacity</Item>
      <Item Name="[Pool Size]">m_pool.size()</Item>
      <Item Name="[Checked Out]">m_resources_checkedout</Item>
      <Item Name="[Shutdown]">m_is_shutdown</Item>
      <Item Name="[Invalidated Resources]">m_counter_abandons</Item>
      <Item Name="[Peak Size]">m_peak_poolsize</Item>
      <Item Name="[Load]">m_pool.size() + m_resources_checkedout</Item>
      <Item Name="[Utilization %]">(m_pool.size() + m_resources_checkedout) * 100 / m_capacity</Item>
      <Item Name="[Counters]">
        <Expand>
          <Item Name="Borrows">m_counter_borrows</Item>
          <Item Name="Returns">m_counter_returns</Item>
          <Item Name="Seeds">m_counter_seeds</Item>
          <Item Name="On-Demand Adds">m_counter_ondemand_adds</Item>
          <Item Name="Abandons">m_counter_abandons</Item>
          <Item Name="Loans">loan_size()</Item>
        </Expand>
      </Item>
      <Item Name="[Callbacks]">
        <Expand>
          <Item Name="Has Factory Callback">m_factory_callback != nullptr</Item>
          <Item Name="Has Cleanup Callback">m_callback_on_resource_cleanup != nullptr</Item>
        </Expand>
      </Item>
    </Expand>
  </Type>

  <!-- ============================================================================
       resource_pool<T> with default template parameters
       ============================================================================ -->
  <Type Name="siddiqsoft::arrp::resource_pool&lt;*&gt;">
    <DisplayString>resource_pool&lt;{$T1}&gt; [size:{m_pool.size()}, checked_out:{m_resources_checkedout}, capacity:{m_capacity}]</DisplayString>
    <Expand>
      <Item Name="[Capacity]">m_capacity</Item>
      <Item Name="[Pool Size]">m_pool.size()</Item>
      <Item Name="[Checked Out]">m_resources_checkedout</Item>
      <Item Name="[Shutdown]">m_is_shutdown</Item>
      <Item Name="[Invalidated Resources]">m_counter_abandons</Item>
      <Item Name="[Peak Size]">m_peak_poolsize</Item>
      <Item Name="[Load]">m_pool.size() + m_resources_checkedout</Item>
      <Item Name="[Utilization %]">(m_pool.size() + m_resources_checkedout) * 100 / m_capacity</Item>
      <Item Name="[Counters]">
        <Expand>
          <Item Name="Borrows">m_counter_borrows</Item>
          <Item Name="Returns">m_counter_returns</Item>
          <Item Name="Seeds">m_counter_seeds</Item>
          <Item Name="On-Demand Adds">m_counter_ondemand_adds</Item>
          <Item Name="Abandons">m_counter_abandons</Item>
          <Item Name="Loans">loan_size()</Item>
        </Expand>
      </Item>
      <Item Name="[Callbacks]">
        <Expand>
          <Item Name="Has Factory Callback">m_factory_callback != nullptr</Item>
          <Item Name="Has Cleanup Callback">m_callback_on_resource_cleanup != nullptr</Item>
        </Expand>
      </Item>
    </Expand>
  </Type>

</AutoVisualizer>
